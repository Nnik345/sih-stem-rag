# Copy this file to .env and fill in real values. .env is git-ignored.
#
#   cp .env.example .env
#
# Every value below has a sane default in src/rag/config.py, so you only need to
# override what differs on your machine. Neo4j credentials are the exception:
# NEO4J_PASSWORD has no usable default and must be set.

# ---------------------------------------------------------------- Neo4j ------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ------------------------------------------------------- Paths (optional) ----
# CORPUS_PATH=curriculum
# PROCESSED_DATA_PATH=curriculum/processed
# EMBEDDING_MODEL_PATH=models/bge-m3
# RERANKER_MODEL_PATH=models/bge-reranker-v2-m3
# REWRITER_MODEL_PATH=models/qwen3-vl-2b-instruct
# GENERATOR_MODEL_PATH=models/qwen3-vl-8b-instruct

# ---------------------------------------------------- Chunking (optional) ----
# CHUNK_TARGET_TOKENS=600
# CHUNK_OVERLAP_TOKENS=100
# CHUNK_MIN_TOKENS=80
# CHUNK_MAX_TOKENS=900

# ---------------------------------------------------- Ingestion (optional) ---
# INGEST_MIN_PAGE_CHARS=40
# INGEST_MIN_SECTION_CHARS=1500
# INGEST_MIN_IMAGE_PIXELS=10000
# INGEST_EXTRACT_IMAGES=true
# OCR is off: approved STEM PDFs/ePUBs have a text layer. Pages without one
# become image-only Page nodes and contribute no chunks.
# INGEST_ENABLE_OCR=false
# INGEST_NEO4J_BATCH_SIZE=200

# --------------------------------------------------- Retrieval (optional) ----
# DENSE_TOP_K=20
# FULLTEXT_TOP_K=20
# GRAPH_SEED_TOP_K=10
# GRAPH_MAX_DEPTH=2
# GRAPH_TOP_K=20
# FUSION_TOP_K=20
# FINAL_TOP_K=5
# RRF_K=60
# WEIGHT_DENSE=1.0
# WEIGHT_FULLTEXT=1.0
# WEIGHT_GRAPH=0.5

# --------------------------------------------- Evidence gate (optional) ------
# EVIDENCE_MIN_RERANK_SCORE=0.0
# EVIDENCE_MIN_CHUNKS=1
# EVIDENCE_MIN_STRONG_CHUNKS=1
# EVIDENCE_REQUIRE_SCOPE_MATCH=true
# EVIDENCE_MIN_QUERY_TERM_OVERLAP=0.15
# EVIDENCE_MIN_PRIOR_GRADE_RERANK_SCORE=1.0

# ------------------------------------------------------ Models (optional) ----
# EMBEDDING_DEVICE=auto
# EMBEDDING_BATCH_SIZE=8
# EMBEDDING_MAX_LENGTH=1024
# RERANKER_DEVICE=auto
# RERANKER_BATCH_SIZE=4
# RERANKER_MAX_LENGTH=1024
# GENERATOR_MAX_NEW_TOKENS=640
# GENERATOR_TEMPERATURE=0.7
# Memory held back from Qwen3-VL-8B weights for vision prefill and the KV cache
# is a floor; actual headroom also scales with the card (~25% of total VRAM,
# capped at 10 GiB). A 32 GiB GPU can keep the 8B tutor fully on device; an
# 8 GiB GPU offloads most layers to system RAM. Raise the floor if generation
# OOMs; set 0 to disable the cap (not recommended).
# GENERATOR_VRAM_RESERVE_GIB=5.5
# GENERATOR_VRAM_HEADROOM_FRACTION=0.25
# Fraction of physical RAM Accelerate may use for CPU-offloaded layers.
# GENERATOR_CPU_RAM_FRACTION=0.80
# 0 = pick Qwen-VL max_pixels from VRAM size. >0 forces that pixel budget.
# GENERATOR_MAX_IMAGE_PIXELS=0
# Per-chunk character budget for the evidence block sent to the generator.
# Prompt length is the main driver of prefill memory use here.
# GENERATOR_MAX_EVIDENCE_CHARS=1000

# ------------------------------------------------- Multimodal (optional) -----
# Image nodes are always ingested. Student photos are query-only input (rewrite
# + image kNN + tutor vision). Textbook figures are not shown in the answer.
# MULTIMODAL_ENABLED=true
# IMAGE_EMBEDDING_MODEL_PATH=models/siglip-base-patch16-224
# IMAGE_TOP_K=8
# IMAGE_MIN_SCORE=0.25
# WEIGHT_IMAGE=1.0
# MAX_ATTACHED_FIGURES=2

# --------------------------------------------------------------- Misc --------
# LOG_LEVEL=INFO
