# =============================================================================
# Gitignored paths and how to recreate them are documented in README.md:
#   First-time local setup
#   What is gitignored and how to restore it
# =============================================================================

# --- Curriculum sources (reproducible) -----------------------------------
# Restore: python scripts/download_curriculum.py
# CISCE PDF is downloaded only for alignment authoring and is never ingested.
curriculum/raw/
curriculum/processed/
core_knowledge_stem/

# OneDrive/SharePoint exports dropped in the repo root (not ingested as zips)
OneDrive_*.zip

# --- Model weights (reproducible) --------------------------------------------
# Restore: python scripts/download_retrieval_models.py
#          python scripts/download_qwen_models.py
models/

# --- Secrets (not reproducible; copy from template) --------------------------
# Restore: cp .env.example .env
.env

# --- Ingestion output (reproducible from corpus + Neo4j) ---------------------
# Restore: python scripts/ingest_corpus.py
data/processed/

# --- Neo4j + bundled JDK 21 (reproducible; tarball install only) --------------
# Restore: README.md -> Neo4j setup (download tarballs, then scripts/neo4j_local.sh)
# Includes extracted Neo4j, bundled Temurin JDK 21, live database files, and tarballs.
# There is no Docker or system-wide Neo4j install in this project.
.neo4j-local/
.neo4j-local/*.tar.gz
.neo4j-local/*-unix.tar.gz

# --- Evaluation labels (hand-curated; not auto-reproducible) -----------------
# Schema docs under data/evaluation/ ARE committed. Only your label file is ignored.
data/evaluation/retrieval_questions.jsonl

# --- Tool and test caches (reproducible) -------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Logs (reproducible by re-running the command) ---------------------------
*.log

# --- Local pyenv configuration -----------------------------------------------
.python-version

# --- Python bytecode and packaging -------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
ENV/

# --- Frontend (visualizer; reproducible from package-lock.json) -------------
# Restore: cd frontend && npm install && npm run build
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.pytest_cache/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Optional local Node.js LTS (only if system Node is unavailable) ---------
# Restore: unpack an official Node.js LTS tarball here; do not install Node system-wide
.tools/

# --- Editor / OS -------------------------------------------------------------
.DS_Store
*.swp
*.swo
.idea/
.vscode/
